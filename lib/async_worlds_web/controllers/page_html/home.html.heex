<Layouts.app flash={@flash} current_scope={assigns[:current_scope]}>
  <section
    id="login-page"
    class="mx-auto grid max-w-5xl items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]"
  >
    <div>
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">
        <span class="h-px w-8 bg-amber-300/70"></span> Private campaign operations
      </p>
      <h1 class="mt-7 text-5xl font-semibold leading-[0.98] tracking-[-0.04em] text-white sm:text-7xl">
        Shape the world between sessions.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-slate-400">
        A focused command center for the configured Dungeon Master. Players remain in Discord; this space is yours alone.
      </p>
    </div>

    <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.045] p-8 shadow-2xl shadow-black/30 sm:p-10">
      <div
        class="absolute -right-16 -top-16 size-44 rounded-full bg-indigo-500/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <span class="grid size-12 place-items-center rounded-2xl bg-[#5865F2]/20 text-[#9aa4ff]">
          <.icon name="hero-user-circle" class="size-7" />
        </span>
        <h2 class="mt-8 text-2xl font-semibold tracking-tight text-white">
          Enter the DM console
        </h2>
        <p class="mt-3 text-sm leading-6 text-slate-400">
          Discord confirms your identity. Access is then matched against the campaign's current DM configuration.
        </p>
        <.link
          id="discord-login"
          href={~p"/auth/discord"}
          class="mt-8 flex w-full items-center justify-center gap-3 rounded-xl bg-[#5865F2] px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-950/40 transition hover:-translate-y-0.5 hover:bg-[#6875f5] hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:ring-offset-2 focus:ring-offset-[#10131d]"
        >
          Continue with Discord <.icon name="hero-arrow-right" class="size-4" />
        </.link>
        <p class="mt-5 flex items-start gap-2 text-xs leading-5 text-slate-500">
          <.icon name="hero-lock-closed" class="mt-0.5 size-3.5 shrink-0" />
          We request identity only. Discord access tokens are never stored in your browser or session.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
